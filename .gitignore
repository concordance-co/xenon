# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.mplconfig/
.uv-cache/
.env

# OS-generated files
.DS_Store

# Virtual environments
.venv

# Local repo noise
.codex/
tmp/
/artifacts/

# Generated pipelines_v2 report materializations (any reports/ subdir).
# Curated typst/md/pdf and assets/scripts/ stay; the report_<hex>_<hex>/
# directories that pipelines_v2 emits do not.
projects/**/reports/**/report_*/
papers/**/reports/**/report_*/
scripts/**/reports/**/report_*/
scripts/reports/**/report_*/

# Auto-generated review HTML rendered at the phase reports/ root.
# (Reviews inside report_*/ are already ignored by the rule above.)
projects/**/reports/*_review.html

# Auto-generated dataset materializations. The jsonl/parquet siblings
# are covered by the data-artifact rules below; csv is the same data
# in a different shape.
projects/**/dataset_exports/*.csv

# Phase-level pipeline outputs: dataset jsonl, pipelines_v2 artifact
# caches, and auto-generated report materializations. Curated
# markdown/pdf lives under phase_*/reports/ and is NOT ignored.
projects/**/phase_*/outputs/

# MoReBench local/raw analysis payloads. Keep scripts, specs, docs, curated
# reports, summaries, and charts in git; keep full prompts/responses,
# annotation shards, batch logs, and replay/capture row dumps local.
projects/MOREBENCH/phase_03/reports/experiment_02_behavior_recommendation_analysis/recommendation_snippets.json
projects/MOREBENCH/phase_03/reports/experiment_02_contested_override_analysis/contested_override_pca_records.json
projects/MOREBENCH/phase_03/reports/experiment_02_contested_override_analysis/contested_override_rows.json
