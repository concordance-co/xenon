{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistant_axis_prompt.schema.json",
  "title": "Assistant Axis BYOP Prompt Row",
  "description": "Rows for generating, steering, and scoring assistant responses from prompts.",
  "type": "object",
  "additionalProperties": true,
  "required": ["example_id", "prompt"],
  "properties": {
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "user", "assistant"]
              },
              "content": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "trait": {
      "type": "string",
      "description": "Released Assistant Axis trait vector to use for steering, e.g. calm."
    },
    "metadata": {
      "type": "object"
    }
  }
}
