        {
          "name": "probe_environment_pressure",
          "runner": "analysis_cpu",
          "spec": {
            "baselines": [
              "majority"
            ],
            "feature": {
              "feature_name": "resid_last_prompt_token",
              "kind": "step_feature_ref",
              "step": "capture_prompt_state_residual"
            },
            "group_by": {
              "dataset": {
                "kind": "dataset_ref",
                "ref": "phase_dataset"
              },
              "kind": "case_set",
              "name": "context_variant_id"
            },
            "kind": "probe",
            "labels": {
              "dataset": {
                "kind": "dataset_ref",
