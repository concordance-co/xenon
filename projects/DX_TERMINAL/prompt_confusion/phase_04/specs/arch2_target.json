              24,
              36,
              44
            ],
            "negative": {
              "kind": "label_predicate",
              "label_set": {
                "kind": "step_label_ref",
                "label_name": "conflict_dimension",
                "step": "pair_delta"
              },
              "op": "equals",
              "value": "action"
            },
            "pooling": {
              "kind": "mean"
            },
            "positive": {
              "kind": "label_predicate",
              "label_set": {
                "kind": "step_label_ref",
                "label_name": "conflict_dimension",
                "step": "pair_delta"
              },
              "op": "equals",
              "value": "size"
            },
            "schema_version": 1,
            "tokens": {
              "kind": "full_sequence"
            }
          }
        },
        {
