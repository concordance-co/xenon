              "step": "pair_delta"
            },
            "tokens": {
              "kind": "full_sequence"
            }
          }
        },
        {
          "name": "basis_pair_delta",
          "runner": "analysis_cpu",
          "spec": {
            "by": {
              "kind": "step_label_ref",
              "label_name": "conflict_dimension",
              "step": "pair_delta"
            },
            "components": 4,
            "feature": {
              "feature_name": "delta",
              "kind": "step_feature_ref",
              "step": "pair_delta"
            },
            "kind": "basis",
            "layers": [
              12,
              24,
              36,
              44
            ],
            "method": "pca",
            "pooling": {
              "kind": "mean"
            },
            "schema_version": 1,
            "tokens": {
              "kind": "full_sequence"
            }
          }
        },
        {
          "name": "direction_pair_delta_size_vs_action",
