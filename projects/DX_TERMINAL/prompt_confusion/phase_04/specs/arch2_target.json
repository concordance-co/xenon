            ],
            "pooling": {
              "kind": "mean"
            },
            "schema_version": 1,
            "split": {
              "dataset": {
                "kind": "dataset_ref",
                "ref": "phase_dataset"
              },
              "kind": "label_set",
              "name": "lexical_split"
            },
            "tokens": {
              "kind": "full_sequence"
            }
          }
        },
        {
          "name": "label_conflict_dimension",
          "runner": "analysis_cpu",
          "spec": {
            "default_value": null,
            "kind": "label_map",
            "mapping": {
              "activity_force_observe": "action",
              "activity_force_trade": "action",
              "diversification_force_concentrate": "asset",
              "holding_force_exit": "action",
              "trade_size_force_large": "size",
              "trade_size_force_small": "size"
            },
            "output_name": "conflict_dimension",
            "schema_version": 1,
            "source": {
              "dataset": {
                "kind": "dataset_ref",
                "ref": "phase_dataset"
              },
              "kind": "label_set",
              "name": "strategy_family"
            },
            "strict": true
          }
        },
        {
          "name": "pair_delta",
          "runner": "analysis_cpu",
          "spec": {
            "case": {
              "dataset": {
                "kind": "dataset_ref",
                "ref": "phase_dataset"
              },
              "kind": "case_set",
              "name": "matched_pair_id"
            },
            "feature": {
              "feature_name": "resid_last_prompt_token",
              "kind": "step_feature_ref",
              "step": "capture_prompt_state_residual"
            },
            "kind": "pair_delta",
            "labels": {
              "conflict_dimension": {
                "kind": "step_label_ref",
                "label_name": "conflict_dimension",
                "step": "label_conflict_dimension"
              },
              "lexical_split": {
                "dataset": {
                  "kind": "dataset_ref",
                  "ref": "phase_dataset"
                },
                "kind": "label_set",
                "name": "lexical_split"
              },
              "matched_pair_id": {
                "dataset": {
                  "kind": "dataset_ref",
                  "ref": "phase_dataset"
                },
                "kind": "case_set",
                "name": "matched_pair_id"
              }
            },
            "negative": {
              "kind": "label_predicate",
              "label_set": {
                "dataset": {
                  "kind": "dataset_ref",
                  "ref": "phase_dataset"
                },
                "kind": "label_set",
                "name": "pair_member"
              },
              "op": "equals",
              "value": "aligned"
            },
            "pooling": {
              "kind": "mean"
            },
            "positive": {
              "kind": "label_predicate",
              "label_set": {
                "dataset": {
                  "kind": "dataset_ref",
                  "ref": "phase_dataset"
                },
                "kind": "label_set",
                "name": "pair_member"
              },
              "op": "equals",
              "value": "strong_conflict"
            },
            "schema_version": 1,
            "tokens": {
              "kind": "full_sequence"
            }
          }
        },
        {
          "name": "probe_pair_delta_conflict_dimension",
          "runner": "analysis_cpu",
          "spec": {
            "baselines": [
              "majority",
              "shuffled_label"
            ],
            "feature": {
              "feature_name": "delta",
              "kind": "step_feature_ref",
              "step": "pair_delta"
            },
            "kind": "probe",
            "labels": {
              "kind": "step_label_ref",
              "label_name": "conflict_dimension",
              "step": "pair_delta"
            },
            "metrics": [
              "accuracy",
