{
  "id": "conflict_probe_v3_smoke",
  "name": "Conflict Probe v3 Smoke",
  "description": "Small smoke workflow for Phase 04 prompt-confusion debugging.",
  "version": 1,
  "dataset": {
    "source": {
      "mode": "sql",
      "sql": "WITH ranked AS ( SELECT row_number() OVER (ORDER BY example_id) AS log_id, src.* FROM conflict_probe_examples_v3 src ) SELECT * FROM ranked WHERE lexical_split = 'train' LIMIT 48"
    },
    "filters": {},
    "label": {
      "mode": "binary_rule",
      "expression_sql": "conflict_present",
      "classes": [
        "aligned",
        "conflict"
      ]
    },
    "split": {
      "mode": "random_stratified",
      "train_pct": 70,
      "val_pct": 15,
      "test_pct": 15
    },
    "probe_defaults": {
      "data_source": "residual",
      "pooling": "last_token",
      "n_folds": 5
    },
    "identity": {
      "column": "example_id"
    },
    "publish_mode": "view"
  },
  "capture": {
    "model": "Qwen/Qwen3-30B-A3B",
    "max_model_len": 8192,
    "capture_generation": false,
    "capture_reasoning": false,
    "enable_thinking": false,
    "add_generation_prompt": true,
    "generation_max_tokens": 256,
    "generation_temperature": 0.0,
    "generation_top_p": 1.0,
    "layers": [0, 12, 24, 36, 44],
    "pooling": "last_token",
    "router": true,
    "residual": true
  },
  "analysis": {
    "methods": [
      "probe"
    ],
    "targets": [
      "workflow_label"
    ],
    "data_source": "residual",
    "pooling": "last_token",
    "n_folds": 5
  },
  "report": {
    "output_dir": "projects/DX_TERMINAL/prompt_confusion/phase_04/reports"
  }
}
