{
  "id": "conflict_probe_v5",
  "name": "Conflict Probe v5",
  "description": "Workflow wrapper for the Phase 08 relational prompt-confusion benchmark on the canonical binary subset.",
  "version": 1,
  "dataset": {
    "source": {
      "mode": "sql",
      "sql": "WITH ranked AS ( SELECT row_number() OVER (ORDER BY example_id) AS log_id, src.* FROM conflict_probe_examples_v5 src ) SELECT * FROM ranked WHERE conflict_present IS NOT NULL"
    },
    "filters": {},
    "label": {
      "mode": "binary_rule",
      "expression_sql": "conflict_present",
      "classes": [
        "aligned",
        "conflict"
      ]
    },
    "split": {
      "mode": "random_stratified",
      "train_pct": 70,
      "val_pct": 15,
      "test_pct": 15
    },
    "probe_defaults": {
      "data_source": "residual",
      "pooling": "prompt_eos",
      "n_folds": 5
    },
    "identity": {
      "column": "example_id"
    },
    "publish_mode": "view"
  },
  "capture": {
    "model": "Qwen/Qwen3-30B-A3B",
    "max_model_len": 8192,
    "capture_generation": false,
    "capture_reasoning": false,
    "enable_thinking": false,
    "add_generation_prompt": false,
    "generation_max_tokens": 256,
    "generation_temperature": 0.0,
    "generation_top_p": 1.0,
    "layers": [
      0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44
    ],
    "pooling": "prompt_eos",
    "router": true,
    "residual": true
  },
  "analysis": {
    "methods": [
      "probe"
    ],
    "targets": [
      "workflow_label"
    ],
    "data_source": "residual",
    "pooling": "prompt_eos",
    "n_folds": 5,
    "group_column": "matched_group_id"
  },
  "report": {
    "output_dir": "projects/DX_TERMINAL/prompt_confusion/phase_08/reports"
  }
}
