  "preflight": {
    "script": "projects/MOREBENCH/phase_02/scripts/analyze_dilemma_family_keyword_variant_preflight.py",
    "baselines": [
      "char-TFIDF char_wb 3-5 LinearSVC, within-variant CV",
      "char-TFIDF char_wb 3-5 LinearSVC, cross-variant transfer (train on variant_a labels, test on variant_b labels; and all 6 ordered directions)",
      "label-agreement matrix across variants (per-row pairwise)"
    ],
    "exit_gate": {
      "pass": "cross-variant char-TFIDF balanced_accuracy <= 0.65 AND label agreement >= 0.70 for all ordered variant pairs",
      "iterate": "cross-variant BA > 0.65 - increase variant disjointness; label agreement < 0.70 - construct is incoherent across variants",
      "fail": "cross-variant BA >= 0.75 - mark shortcut-dominated in known_bugs, do not promote to phase 03"
    }
